// Prisma schema — https://pris.ly/d/prisma-schema
// Connection URLs live in prisma.config.ts (Prisma 7+).

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Gallery
// ---------------------------------------------------------------------------

model Album {
  id         Int      @id @default(autoincrement())
  title      String   @db.VarChar(100)
  coverImage String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  photos Photo[]

  @@index([createdAt(sort: Desc)])
  @@map("albums")
}

model Photo {
  id        Int      @id @default(autoincrement())
  /// Human readable name of the uploaded file.
  filename  String   @db.VarChar(255)
  /// Publicly reachable URL of the stored blob.
  url       String   @db.Text
  size      Int
  mimeType  String   @db.VarChar(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  albumId Int
  album   Album @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@index([albumId, createdAt])
  @@map("photos")
}

// ---------------------------------------------------------------------------
// Class schedule
// ---------------------------------------------------------------------------

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model Schedule {
  id        Int      @id @default(autoincrement())
  dayOfWeek Weekday
  /// Minutes since midnight, so slots sort chronologically.
  startsAt  Int
  endsAt    Int
  ageGroup  String   @db.VarChar(50)
  className String?  @db.VarChar(100)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, dayOfWeek, startsAt])
  @@map("schedule")
}

// ---------------------------------------------------------------------------
// Referrer tracking
// ---------------------------------------------------------------------------

model Track {
  id        Int      @id @default(autoincrement())
  from      String   @db.Text
  to        String   @db.Text
  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@map("track")
}

// ---------------------------------------------------------------------------
// Authentication (managed by better-auth)
// ---------------------------------------------------------------------------

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@index([identifier])
  @@map("verification")
}
